# Porta HTTP (hospedagens como o Render definem automaticamente)
PORT=3000
# Caminho do arquivo SQLite; padrão: src/db/rocketq.sqlite
DATABASE_FILE=
# Custo do bcrypt (10 é o recomendado para o MVP)
BCRYPT_COST=10
# Use 1 atrás de proxy reverso (Render, alwaysdata) para o limite por IP funcionar
TRUST_PROXY=0
