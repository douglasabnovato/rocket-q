<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= page === 'create-pass' ? 'Criar sala' : 'Entrar numa sala' %> · Rocket.Q</title>
        <meta name="description" content="Crie uma sala e receba perguntas anônimas do seu público.">
        <link rel="icon" href="/images/logo.svg" type="image/svg+xml">
        <link rel="stylesheet" href="/styles/global.css">
        <link rel="stylesheet" href="/styles/home.css">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Open+Sans&family=Poppins:wght@500;700&display=swap" rel="stylesheet">
    </head>
    <body>
        <div id="home" class="content">
            <header>
                <a href="/" aria-label="Rocket.Q, página inicial">
                    <img src="/images/logo.svg" alt="Rocket.Q" width="167" height="44">
                </a>
            </header>
            <div id="bg" aria-hidden="true">
                <div class="ball top"></div>
                <div class="ball bottom"></div>
            </div>
            <main>
                <div class="container">
                    <% if (typeof error !== 'undefined' && error) { %>
                        <p class="alert alert-error" role="alert"><%= error %></p>
                    <% } %>
                    <%- include(`parts/${page}`) %>
                </div>
            </main>
        </div>
    </body>
</html>
