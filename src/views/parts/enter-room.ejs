<section aria-labelledby="enter-title">
    <h1 id="enter-title">Entre como participante</h1>
    <form action="/enterroom" method="POST">
        <label class="sr-only" for="room-code">Código da sala (6 dígitos)</label>
        <input name="roomId" type="text" id="room-code" inputmode="numeric" pattern="\d{1,6}" maxlength="6" autocomplete="off" required placeholder="Código da sala">
        <button type="submit">
            <img src="/images/enter-room.svg" alt="" aria-hidden="true">
            Entrar na sala
        </button>
    </form>
</section>
<div class="separator" aria-hidden="true">
    <div></div>
    <div>ou</div>
    <div></div>
</div>
<section aria-labelledby="create-title">
    <h2 id="create-title">Crie sua própria sala de forma fácil</h2>
    <a href="/create-pass" class="button outlined">
        <img src="/images/users.svg" alt="" aria-hidden="true">
        Criar sala
    </a>
</section>
