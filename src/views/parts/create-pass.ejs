<section aria-labelledby="create-pass-title">
    <h1 id="create-pass-title">Crie sua própria sala</h1>
    <form action="/create-room" method="POST">
        <label class="sr-only" for="room-pass">Senha de administração da sala</label>
        <input type="password" name="password" id="room-pass" minlength="6" maxlength="72" autocomplete="new-password" required aria-describedby="room-pass-hint" placeholder="Crie uma senha">
        <p class="hint" id="room-pass-hint">De 6 a 72 caracteres. Você vai usá-la para marcar perguntas como lidas e excluí-las.</p>
        <button type="submit">
            <img src="/images/users-white.svg" alt="" aria-hidden="true">
            Criar sala
        </button>
    </form>
    <a href="/" class="back-link">Voltar para entrar numa sala</a>
</section>
